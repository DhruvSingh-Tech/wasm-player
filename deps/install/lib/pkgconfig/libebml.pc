prefix=/home/dhruv-dev/Projects/prototype2/deps/install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name:        libebml
Description: Library for parsing EBML data structures
Version:     2.0.0
Libs:        -L${libdir} -lebml
Cflags:      -I${includedir} -DEBML_STATIC_DEFINE
